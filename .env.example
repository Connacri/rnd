# Copiez ce fichier en `.env` et renseignez vos vraies valeurs.
# `.env` est ignoré par git — ne JAMAIS committer de vraies clés.
#
# Utilisation en local :
#   flutter run --dart-define-from-file=.env
#
# Utilisation pour builder :
#   flutter build apk --release --dart-define-from-file=.env
#
# Récupérez ces valeurs depuis Supabase Dashboard > Project Settings > API.
# SUPABASE_ANON_KEY est la clé "anon / public" (PAS la service_role key,
# qui ne doit JAMAIS être intégrée dans une app client).

SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
