rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && (request.auth.token.admin == true || request.auth.token.role == 'admin');
    }
    // Candidate records contain private Google addresses and moderation metadata.
    match /candidates/{candidateId} {
      allow read, create, update, delete: if isAdmin();
    }
    // This collection is a strict public projection; never store private fields here.
    match /publishedCandidates/{candidateId} {
      allow read: if true;
      allow create, update, delete: if false;
    }
    match /candidateAccess/{document=**} { allow read, write: if false; }
    match /candidatePinAttempts/{document=**} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}