rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && (request.auth.token.admin == true || request.auth.token.role == 'admin');
    }
    match /candidates/{candidateId} {
      allow read: if isAdmin() || (
        resource.data.profile_status == 'approved' &&
        resource.data.is_published == true &&
        resource.data.is_active == true &&
        resource.data.is_office_profile == false
      );
      allow create, update, delete: if isAdmin();
    }
    match /candidateAccess/{document=**} { allow read, write: if false; }
    match /candidatePinAttempts/{document=**} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}