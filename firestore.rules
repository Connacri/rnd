rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && (request.auth.token.admin == true || request.auth.token.role == 'admin'); }
    match /siteContent/{document} { allow read: if true; allow write: if isAdmin(); }
    match /programPillars/{id} { allow read: if true; allow write: if isAdmin(); }
    match /campaignNews/{id} { allow read: if true; allow write: if isAdmin(); }
    match /councilCandidates/{id} { allow read: if true; allow write: if isAdmin(); }
    match /membershipSubmissions/{id} {
      allow create: if request.resource.data.keys().hasAll(['fullName','email','phone','submittedAt'])
        && request.resource.data.fullName is string && request.resource.data.fullName.size() <= 120
        && request.resource.data.email is string && request.resource.data.email.size() <= 254
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 40;
      allow read, update, delete: if isAdmin();
    }
    match /candidates/{candidateId} {
      allow read: if isAdmin() || (signedIn() && resource.data.google_email == request.auth.token.email);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        signedIn()
        && resource.data.google_email == request.auth.token.email
        && resource.data.is_office_profile != true
        && request.resource.data.google_email == resource.data.google_email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'photo_url', 'profession', 'education_level', 'diplomas',
          'experience', 'skills', 'motivation', 'profile_status', 'is_published',
          'is_active', 'submitted_at', 'updated_at'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 120
        && request.resource.data.photo_url is string
        && request.resource.data.photo_url.size() <= 2048
        && request.resource.data.profession is map
        && request.resource.data.education_level is map
        && request.resource.data.diplomas is map
        && request.resource.data.experience is map
        && request.resource.data.skills is map
        && request.resource.data.motivation is map
        && request.resource.data.profile_status == 'pending'
        && request.resource.data.is_published == false
        && request.resource.data.is_active == true
      );
    }
    match /publishedCandidates/{candidateId} { allow read: if true; allow create, update, delete: if isAdmin(); }
    match /candidateAccess/{document=**} { allow read, write: if false; }
    match /candidatePinAttempts/{document=**} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}