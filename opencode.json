{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "timeout": {
      "startup": 120000,
      "catalog": 120000,
      "execution": 600000
    },
    "servers": {
      "supabase": {
        "type": "remote",
        "url": "https://mcp.supabase.com/mcp?project_ref=liveclvibiqcpekanfbp&features=docs%2Caccount%2Cdatabase%2Cdebugging%2Cdevelopment%2Cfunctions%2Cbranching"
      },
      "firebase": {
        "type": "local",
        "command": ["npx", "-y", "firebase-tools@latest", "mcp"],
        "cwd": ".",
        "timeout": {
          "startup": 120000,
          "catalog": 120000,
          "execution": 600000
        }
      }
    }
  }
}