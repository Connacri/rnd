{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "timeout": {
      "startup": 120000,
      "catalog": 120000,
      "execution": 600000
    },
    "servers": {
      "supabase": {
        "type": "remote",
        "url": "https://mcp.supabase.com/mcp?project_ref=liveclvibiqcpekanfbp&features=docs%2Caccount%2Cdatabase%2Cdebugging%2Cdevelopment%2Cfunctions%2Cbranching"
      },
      "firebase": {
        "type": "local",
        "command": ["npx", "-y", "firebase-tools@latest", "mcp"],
        "cwd": ".",
        "timeout": {
          "startup": 120000,
          "catalog": 120000,
          "execution": 600000
        }
      },
      "google-play": {
        "type": "local",
        "command": ["uvx", "--with", "mcp<2", "google-play-mcp"],
        "environment": {
          "GOOGLE_PLAY_PACKAGE_NAME": "com.rnd.dz"
        },
        "timeout": {
          "startup": 120000,
          "catalog": 120000,
          "execution": 600000
        }
      },
      "render": {
        "type": "remote",
        "url": "https://mcp.render.com/mcp",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:RENDER_API_KEY}"
        }
      }
    }
  }
}
