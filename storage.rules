rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && (request.auth.token.admin == true || request.auth.token.role == 'admin');
    }

    match /candidate-photos/submissions/{candidateUid}/{fileName} {
      // Candidate profile images are delivered through their Firebase download URL.
      allow read: if true;

      // Each candidate can upload only into their own UID folder.
      // Administrators retain moderation and cleanup access.
      allow write: if isAdmin() || (
        signedIn()
        && request.auth.uid == candidateUid
        && request.auth.token.email_verified == true
        && request.resource != null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)')
      );
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
